#!/bin/bash
# gitea-ci — Gitea Actions 查询 CLI（配 gitea-ci skill 使用）
# 配置：用户级配置文件（默认 ~/.config/gitea-ci/config.json，GITEA_CI_CONFIG 可改路径）：
#   {
#     "default": "work",
#     "instances": {
#       "work": { "api_base": "https://gitea.example.com/api/v1", "org": "my-org", "token": "..." },
#       "home": { "api_base": "http://gitea.lan:3000/api/v1", "token_file": "~/.gitea-home-token" }
#     }
#   }
#   token 内联或 token_file 引用独立文件，二选一；配置文件建议 chmod 600。
# 用法:
#   gitea-ci list [repo] [limit]        最近 runs（limit 默认 5）
#   gitea-ci fail [repo] [limit]        最近失败的 runs
#   gitea-ci jobs <run_id> [repo]       某 run 的 job/step 结论
#   gitea-ci log  <job_id> [repo]       某 job 的完整日志（明文）
#   gitea-ci -i <实例名> <子命令> ...    选用指定实例（缺省取 default，仅一个实例时可省）
# 环境变量覆盖: GITEA_API_BASE / GITEA_ORG / GITEA_TOKEN_FILE
set -euo pipefail

CONFIG_FILE="${GITEA_CI_CONFIG:-$HOME/.config/gitea-ci/config.json}"

instance="${GITEA_CI_INSTANCE:-}"
if [ "${1:-}" = "-i" ]; then
  instance="${2:?用法: gitea-ci -i <实例名> <子命令> ...}"
  shift 2
fi

resolved="$(python3 - "$CONFIG_FILE" "$instance" <<'PY'
import json, os, sys
path, inst = sys.argv[1], sys.argv[2]
p = os.path.expanduser(path)
try:
    cfg = json.load(open(p))
except FileNotFoundError:
    sys.exit("缺少配置文件 %s —— 创建它并填入 instances（模板见 gitea-ci skill §0）" % path)
except json.JSONDecodeError as e:
    sys.exit("配置文件 %s 不是合法 JSON: %s" % (path, e))
instances = cfg.get("instances", {})
if not inst:
    inst = cfg.get("default") or (next(iter(instances)) if len(instances) == 1 else None)
if not inst or inst not in instances:
    sys.exit("实例 %r 未在 %s 定义（现有: %s）" % (inst, path, ", ".join(instances) or "无"))
v = instances[inst]
api_base = os.environ.get("GITEA_API_BASE") or v.get("api_base", "")
org = os.environ.get("GITEA_ORG") or v.get("org", "")
token = ""
tf = os.environ.get("GITEA_TOKEN_FILE") or v.get("token_file", "")
if tf:
    tfp = os.path.expanduser(tf)
    try:
        token = open(tfp).read().strip()
    except FileNotFoundError:
        sys.exit("token 文件不存在: %s" % tfp)
if not token:
    token = (v.get("token") or "").strip()
if not token:
    sys.exit("实例 %r 未配置 token 或 token_file" % inst)
if not api_base:
    sys.exit("实例 %r 未配置 api_base" % inst)
print(api_base)
print(token)
print(org)
PY
)"
BASE="$(sed -n 1p <<<"$resolved")"
TOKEN="$(sed -n 2p <<<"$resolved")"
ORG="$(sed -n 3p <<<"$resolved")"

org_repo() {
  case "$1" in
    */*) printf '%s' "$1" ;;
    *) [ -n "$ORG" ] || { echo "repo 未含 owner 且实例未配 org，无法定位 $1" >&2; exit 1; }
       printf '%s/%s' "$ORG" "$1" ;;
  esac
}

api() { # $1=owner/repo  $2=路径
  curl -sS -m 15 -H "Authorization: token $TOKEN" "$BASE/repos/$(org_repo "$1")$2"
}

list_runs() {
  local repo="$1" limit="$2" only="${3:-}"
  api "$repo" "/actions/tasks?limit=$limit" | python3 -c '
import json,sys,re
only = sys.argv[1]
d = json.load(sys.stdin)
rows = d.get("workflow_runs", [])
if only:
    rows = [r for r in rows if r.get("status") == only]
for r in rows:
    m = re.search(r"/runs/(\d+)", r.get("url",""))
    run_id = m.group(1) if m else "?"
    line = "%6s  #%-4s %-9s %-14s %-32s %s  %s" % (
        run_id, r.get("run_number"), r.get("status"), r.get("head_branch","-"),
        r.get("workflow_id",""), r.get("created_at","")[:16], r.get("display_title","")[:48])
    print(line)
' "$only"
  if [ "$only" = "failure" ]; then echo "→ 查日志: gitea-ci jobs <run_id> $repo" >&2; fi
}

show_jobs() {
  local run="$1" repo="$2"
  api "$repo" "/actions/runs/$run/jobs" | python3 -c '
import json,sys
repo = sys.argv[1]
d = json.load(sys.stdin)
for j in d.get("jobs", []):
    print("job %s  %s/%s  runner=%s" % (j["id"], j.get("status"), j.get("conclusion"), j.get("runner_name","-")))
    for s in j.get("steps", []):
        print("  %s/%s  %s" % (s.get("status"), s.get("conclusion"), s.get("name")))
    print("→ 日志: gitea-ci log %s %s" % (j["id"], repo))
' "$repo"
}

cmd="${1:-list}"
case "$cmd" in
  list) list_runs "${2:?用法: gitea-ci list <owner/repo 或 repo>}" "${3:-5}" "" ;;
  fail) list_runs "${2:?用法: gitea-ci fail <owner/repo 或 repo>}" "${3:-5}" "failure" ;;
  jobs) show_jobs "$2" "${3:?用法: gitea-ci jobs <run_id> <owner/repo 或 repo>}" ;;
  log)  api "${3:?用法: gitea-ci log <job_id> <owner/repo 或 repo>}" "/actions/jobs/$2/logs" ;;
  *) sed -n '2,18p' "$0"; exit 1 ;;
esac
